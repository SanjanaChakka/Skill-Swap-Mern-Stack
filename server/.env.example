# Server port
PORT=5000

# MongoDB connection string (local or Atlas)
MONGO_URI=mongodb://localhost:27017/skillswap

# JWT secret - change in production
JWT_SECRET=skillswap-dev-secret-change-me

# Frontend origin allowed by CORS
CLIENT_URL=http://localhost:5173

# SMTP settings (optional - falls back to console logging if empty)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="SkillSwap <no-reply@skillswap.dev>"
